# Config de PRODUCCIÓN. Rsbuild carga este archivo en `bun run build` y sus
# valores quedan inlineados en el bundle.
#
# La config web de Firebase es pública por diseño (viaja en el JS a todo
# visitante); la seguridad la dan Firebase Auth y las Security Rules.

# Backend RELATIVO al origen de la página: funciona igual con IP pura o con
# dominio, http o https, sin rebuild al cambiar de host. Requiere que /api
# llegue al backend — lo resuelve el nginx de esta misma imagen (proxy a
# backend:9000) o el reverse proxy del servidor, el que llegue primero.
# El websocket se deriva de aquí: ws(s)://<host de la página>/api/ws
#
# Si algún día el backend queda en OTRO origen (p.ej. http://IP:9000 directo),
# definir PUBLIC_BACKEND_URL como build-arg en el .env del server
# (docker compose lo pasa; ver .env.example del backend) — eso pisa este valor.
PUBLIC_BACKEND_URL=/api

PUBLIC_FIREBASE_API_KEY=AIzaSyDNhS5XDrqBsT56Hk0mBbJFjDTm_gIWUJQ
PUBLIC_FIREBASE_AUTH_DOMAIN=usersopsim.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=usersopsim
PUBLIC_FIREBASE_STORAGE_BUCKET=usersopsim.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=40891557977
PUBLIC_FIREBASE_APP_ID=1:40891557977:web:aa552eaef3721e79442948
